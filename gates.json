{
  "modes": {
    "all": [
      "self-test",
      "notes",
      "pairing",
      "note-presence",
      "rubric",
      "archive",
      "decisions"
    ],
    "quick": [
      "notes",
      "note-presence"
    ]
  },
  "defaultMode": "all",
  "concurrency": 4,
  "gates": [
    {
      "id": "self-test",
      "label": "governance rejection cases",
      "command": [
        "gov",
        "self-test"
      ],
      "paths": [
        "gov/**",
        "tests/**",
        "gates.json",
        "pyproject.toml"
      ]
    },
    {
      "id": "notes",
      "label": "note format",
      "command": [
        "gov",
        "verify-notes"
      ],
      "paths": [
        ".agents/notes/**"
      ]
    },
    {
      "id": "pairing",
      "label": "bilingual pairing",
      "command": [
        "gov",
        "verify-pairing"
      ],
      "paths": [
        "docs/**",
        "README*",
        ".gov/pairing.json"
      ]
    },
    {
      "id": "note-presence",
      "label": "non-trivial changes carry an Agent Note (advisory)",
      "command": [
        "gov",
        "verify-note-presence"
      ]
    },
    {
      "id": "rubric",
      "label": "review rubric structure",
      "command": [
        "gov",
        "verify-rubric"
      ],
      "paths": [
        "docs/review-rubric.md",
        "docs/review-rubric.zh.md"
      ]
    },
    {
      "id": "archive",
      "label": "archived-notes seal",
      "command": [
        "gov",
        "verify-archive"
      ],
      "paths": [
        ".agents/notes/archived/**"
      ]
    },
    {
      "id": "decisions",
      "label": "decisions table guard",
      "command": [
        "gov",
        "verify-decisions"
      ],
      "paths": [
        "docs/decisions.md"
      ]
    }
  ]
}
