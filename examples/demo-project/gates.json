{
  "modes": {
    "all": ["notes", "pairing", "note-presence"],
    "quick": ["notes"],
    "governance": ["self-test"]
  },
  "defaultMode": "all",
  "concurrency": 4,
  "gates": [
    {
      "id": "self-test",
      "label": "governance rejection cases (the govrail tools' own regression)",
      "command": ["gov", "self-test"]
    },
    {
      "id": "notes",
      "label": "note format",
      "command": ["gov", "verify-notes"],
      "paths": [".agents/notes/**"]
    },
    {
      "id": "pairing",
      "label": "bilingual pairing (advisory until baselined)",
      "command": ["gov", "verify-pairing"],
      "allowFailure": true,
      "paths": ["docs/**", "README*", ".gov/pairing.json"]
    },
    {
      "id": "note-presence",
      "label": "non-trivial changes carry an Agent Note (advisory)",
      "command": ["gov", "verify-note-presence"]
    }
  ]
}
